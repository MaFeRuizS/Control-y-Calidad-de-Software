  m_text: "\u2022 <b>Practica todos los d\xEDas</b> - <size=85%>Aunque sea 10 minutos</size>\r\n\r\n\u2022
    <b>Lee en voz alta</b> - <size=85%>Mejora pronunciaci\xF3n y fluidez</size>\r\n\r\n\u2022
    <b>Escucha m\xFAsica y ve pel\xEDculas</b> - <size=85%>Con subt\xEDtulos en ingl\xE9s</size>\r\n\r\n\u2022
    <b>No tengas miedo de cometer errores</b> - <size=85%>Son parte del aprendizaje</size>\r\n\r\n\u2022
    <b>Aprende frases completas</b> - <size=85%>No solo palabras aisladas</size>"
  m_isRightToLeft: 0
