      m_Calls: []
  m_text: "<b>Los tres tiempos b\xE1sicos en ingl\xE9s:</b>\n\n<color=#99FF99><b>Presente</b><pos=25%><b>Pasado</b><pos=50%><b>Futuro</b></color>\r\n\r\n<size=85%>Acciones
    habituales<pos=25%>Acciones completadas<pos=50%>Acciones futuras</size>\r\n\r\n\u2022
    I <b>play</b><pos=25%>\u2022 I <b>played</b><pos=50%>\u2022 I <b>will play</b>\r\n\u2022
    She <b>likes</b><pos=25%>\u2022 She <b>liked</b><pos=50%>\u2022 She <b>will like</b>\r\n\u2022
    They <b>study</b><pos=25%>\u2022 They <b>studied</b><pos=50%>\u2022 They <b>will
    study</b>\r\n\r\n<size=85%><color=#99FF99>Nota: -s en 3ra pers.<pos=25%>Nota:
    Verbos +ed<pos=50%>Nota: will + verbo</color></size>\n\n\n<size=75%><color=#99FF99><b>Recordar:</b></color>
    Presente (ahora), Pasado (ayer), Futuro (ma\xF1ana)</size>\n"
  m_isRightToLeft: 0
