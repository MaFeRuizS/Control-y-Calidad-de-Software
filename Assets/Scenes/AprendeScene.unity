  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Orden b\xE1sico de las palabras en ingl\xE9s:</b>\n\n<align=center><color=#FFFF00><size=120%><b>Subject
    + Verb + Object</b></size></color>\r\n<size=80%>(Sujeto + Verbo + Objeto)</size></align>\n\n<color=#FFFF00><b>Afirmativa:</b></color>\r\n<color=#FF99CC>I</color>
    <color=#00FF00>eat</color> <color=#33CCFF>apples</color>\r\n<size=80%><color=#A6A6A6>(Yo
    como manzanas)</color></size>\n\n<color=#FFFF00><b>Negativa:</b></color>\r\n<color=#FF99CC>I</color>
    <color=#FF6666>do not (don't)</color> <color=#00FF00>eat</color> <color=#33CCFF>apples</color>\r\n<size=80%><color=#A6A6A6>(Yo
    no como manzanas)</color></size>\n\n<color=#FFFF00><b>Pregunta:</b></color>\r\n<color=#FF6666>Do</color>
    <color=#FF99CC>you</color> <color=#00FF00>eat</color> <color=#33CCFF>apples</color>?\r\n<size=80%><color=#A6A6A6>(\xBFComes
    manzanas?)</color></size>\n\n\n<size=75%><color=#FFFF00><b>Diferencia con espa\xF1ol:</b></color>
    En ingl\xE9s, el adjetivo va <color=#FFFF00><b>antes</b></color> del sustantivo:
    \"a <color=#FFFF00><b>red</b></color> car\" (un coche rojo).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
