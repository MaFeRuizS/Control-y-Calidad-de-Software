      m_Calls: []
  m_text: "<b>Definici\xF3n:</b> Palabras que reemplazan a los sustantivos (nombres).\n\n<color=#FFFF00><b>Pronombres
    Personales:</b></color>\n\n<color=#FF99CC><b>Singular:</b></color><pos=55%><color=#FF99CC><b>Plural:</b></color>\r\n\r\n<b>I</b> 
    \u2192 Yo<pos=55%><b>We</b> \u2192 Nosotros/as\r\n<b>You</b> \u2192 T\xFA / Usted<pos=55%><b>You</b>
    \u2192 Ustedes\r\n<b>He</b>  \u2192 \xC9l<pos=55%><b>They</b> \u2192 Ellos/as\r\n<b>She</b>
    \u2192 Ella\r\n<b>It</b>  \u2192 Eso (animal/cosa)\n\n\n<size=75%><b>Nota:</b>
    En ingl\xE9s, <color=#CCCCFF><b>\"you\"</b></color> se usa tanto para singular
    como para plural, a diferencia del espa\xF1ol (t\xFA/ustedes).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
