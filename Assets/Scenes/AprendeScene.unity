  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. <b>Observa</b> los primeros t\xE9rminos de la sucesi\xF3n\r\n\r\n2.
    <b>Identifica</b> la relaci\xF3n entre t\xE9rminos consecutivos\r\n\r\n3. <b>Verifica</b>
    que la regla funcione para todos los t\xE9rminos\r\n\r\n4. <b>Aplica</b> la regla
    para encontrar el siguiente t\xE9rmino\r\n\r\n<indent=5%><size=85%><color=#D1D1D1FF><voffset=1em><b>Ejemplo:</b>
    <color=#FFFF00>3, 7, 11, 15, ?</color> \u2192 Diferencia: +4 \u2192 Siguiente:
    <color=#FFFF00><b>19</b></color></voffset></color></size></indent>"
  m_isRightToLeft: 0
