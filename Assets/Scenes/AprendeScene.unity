  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Definici\xF3n: </b>Palabras que acompa\xF1an a los sustantivos.\n\n<color=#27A3F5><b>Art\xEDculos
    Indefinidos (algo no espec\xEDfico):</b></color>\r\n\r\n<b>A</b> \u2192 Un/Una
    (antes de consonante)\r\n   <size=85%>\u2022 A <b>dog</b> (un perro) \u2022 A
    <b>book</b> (un libro)</size>\r\n\r\n<b>An</b> \u2192 Un/Una (antes de vocal)\r\n  
    <size=85%>\u2022 An <b>apple</b> (una manzana) \u2022 An <b>elephant</b> (un
    elefante)</size>\n\n<color=#27A3F5><b>Art\xEDculo Definido (algo espec\xEDfico):</b></color>\r\n\r\n<b>The</b>
    \u2192 El/La/Los/Las\r\n   <size=85%>\u2022 <b>The</b> dog (el perro) \u2022
    <b>The</b> apples (las manzanas)</size>\n\n<size=75%><b>Diferencia:</b> \"A/An\"
    = cualquiera (indefinido). \"The\" = uno espec\xEDfico (definido).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
